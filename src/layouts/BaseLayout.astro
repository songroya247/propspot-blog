---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, any>;
}
const {
  title,
  description = 'Guides, neighborhood insight, and practical advice on renting, buying, and finding your next place in Nigeria.',
  image,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — PropSpot Journal</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="PropSpot Journal" href="/rss.xml" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="PropSpot Journal" />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <header class="site-header">
    <div class="header-row">
      <a class="brand" href="/">
        <span class="brand-mark">P</span>
        <span>
          <span class="brand-name">PropSpot Journal</span>
          <span class="brand-tag">Guides for finding home</span>
        </span>
      </a>
      <a class="back-link" href="https://propspot.ultimateedge.info">← Back to listings</a>
    </div>
  </header>
  <slot />
  <footer class="site-footer">
    © {new Date().getFullYear()} PropSpot — part of UltimateEdge
  </footer>
</body>
</html>
